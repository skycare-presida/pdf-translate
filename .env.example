# Copy to .env alongside the service file and fill in. Never commit the real .env.

# Shared secret that Presida (FileMaker) sends in the Authorization header
TRANSLATE_API_KEY=change-me

# OVHcloud AI Endpoints key — EU-hosted Mistral + Llama for GDPR compliance
OVHCLOUD_API_KEY=change-me

# DeepL API key — primary translation engine. Use a Pro key for patient
# documents (Free keys end ":fx" and DeepL may retain Free-plan text). The
# free/pro endpoint is chosen automatically from the key. If unset, or if
# DeepL fails, translation falls back to the OVHcloud models above.
DEEPL_AUTH_KEY=change-me

# Optional:
# TRANSLATE_ENGINE=deepl          # "llm" switches DeepL off entirely
# DEEPL_ENGLISH_VARIANT=EN-GB     # or EN-US
# DEEPL_MODEL_TYPE=prefer_quality_optimized
